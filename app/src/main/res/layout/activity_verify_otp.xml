<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9E6"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xác nhận mã OTP"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF6B35"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvPhoneHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mã đã được gửi đến số: "
            android:textSize="14sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Ô nhập 6 số OTP -->
        <EditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Nhập mã xác nhận"
            android:inputType="number"
            android:maxLength="6"
            android:gravity="center"
            android:textSize="16sp"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="24dp" />

        <!-- Nút xác nhận -->
        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Xác nhận"
            android:textSize="16sp"
            android:backgroundTint="#FF6B35"
            android:layout_marginBottom="16dp" />

        <!-- Gửi lại mã -->
        <TextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gửi lại mã"
            android:textColor="#FF6B35"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Quay lại -->
        <TextView
            android:id="@+id/tvGoBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quay lại"
            android:textColor="#888888" />

    </LinearLayout>
</ScrollView>