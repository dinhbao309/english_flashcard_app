<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyền truy cập Internet cho Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.English_flashcard_app"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <!-- Splash: màn hình khởi động -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login: màn hình đăng nhập -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Register: màn hình đăng ký -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Main: màn hình chính -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Forgot Password -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".VerifyOtpActivity"
            android:exported="false" />
        <activity
            android:name=".ResetPasswordActivity"
            android:exported="false" />
        
        <!-- Topic Selection -->
        <activity
            android:name=".TopicActivity"
            android:exported="false" />
        
        <!-- FlashCard Learning -->
        <activity
            android:name=".FlashCardActivity"
            android:exported="false" />
        
        <!-- Result Screen -->
        <activity
            android:name=".ResultActivity"
            android:exported="false" />
        
        <!-- Quiz Game -->
        <activity
            android:name=".QuizActivity"
            android:exported="false" />
        
        <!-- Matching Game -->
        <activity
            android:name=".MatchingGameActivity"
            android:exported="false" />
        
        <!-- Matching Result -->
        <activity
            android:name=".MatchingResultActivity"
            android:exported="false" />
    </application>

</manifest>
